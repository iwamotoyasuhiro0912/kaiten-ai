# ============================================================
# 🍣 Kaiten AI Gateway - 環境変数サンプル
# このファイルを .env にコピーして値を設定してください
# ============================================================

# ── アプリ設定 ────────────────────────────────────────────
PORT=8300
DB_PATH=data/kaiten.db
ROOT_PATH=/kaiten-ai        # nginx プレフィックス

# ── 認証（必ず設定！ 空のままでは認証なし）──────────────────
ADMIN_USER=admin
ADMIN_TOKEN=                # ← ここに強固なパスワードを設定すること

# ── APIキー（無料プロバイダーのみ）────────────────────────
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras: https://inference.cerebras.ai/
CEREBRAS_API_KEY=
